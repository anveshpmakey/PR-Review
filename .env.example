# --- Server ---
PORT=3000
LOG_LEVEL=info

# --- Bitbucket Cloud ---
# Either a repository/workspace access token (recommended) ...
BITBUCKET_ACCESS_TOKEN=
# ... or username + app password (scopes: pullrequest:write, repository:read)
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
# Default repo for the CLI (the webhook uses repository.full_name from the payload)
BITBUCKET_WORKSPACE=
BITBUCKET_REPO_SLUG=
# Optional comma-separated allow-list of workspace/repo names for the webhook
ALLOWED_REPOS=

# Secret configured on the Bitbucket webhook (verifies X-Hub-Signature HMAC-SHA256)
WEBHOOK_SECRET=

# --- LLM providers ---
# Comma-separated chain tried in order; later providers are used when earlier ones fail
# (outage, quota, bad key). When unset, every provider with credentials is used in the order:
# anthropic, openai, gemini, groq, openrouter, mistral, huggingface, deepseek, ollama.
# Supported: anthropic (alias claude), openai, ollama (alias local), groq, openrouter, gemini,
# huggingface (alias hf), mistral, deepseek, mock
AI_PROVIDER=anthropic
AI_FALLBACK_PROVIDERS=groq,openrouter,ollama
LLM_FALLBACK_COOLDOWN_MS=300000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Any OpenAI-compatible endpoint (Azure OpenAI v1, LiteLLM, vLLM, LM Studio, LocalAI...)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Self-hosted open-source models via Ollama (no API key). Set OLLAMA_MODEL or OLLAMA_BASE_URL to enable auto-detection.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:14b

# Free tiers of hosted open models
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
HF_TOKEN=
# HF_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Per provider you can also set <PREFIX>_BASE_URL, <PREFIX>_STRUCTURED_OUTPUT (json_schema|json_object|none)
# and <PREFIX>_TOKEN_PARAM (max_tokens|max_completion_tokens).

LLM_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_MS=180000
LLM_MAX_RETRIES=3
# LLM_TEMPERATURE=0.2

# --- Review behaviour ---
# general | java-spring
REVIEW_PROFILE=general
# Repo-specific rules file read from the PR's destination branch
REVIEW_GUIDELINES_PATH=.pr-review.md
# Extra inline guidelines applied to every repo
REVIEW_GUIDELINES=
INCLUDE_FILE_CONTEXT=true
MAX_CONTEXT_FILE_CHARS=20000
MAX_DIFF_CHARS=60000
MAX_CHUNKS=10
REVIEW_CONCURRENCY=2
# low | medium | high | critical
MIN_SEVERITY=low
MIN_CONFIDENCE=0.5
MAX_INLINE_COMMENTS=15
# Comma-separated globs
IGNORE_PATHS=
INCLUDE_PATHS=
SKIP_DRAFTS=true
REVIEW_TRIGGER_PHRASE=/ai-review

POST_GENERAL_COMMENT=true
POST_INLINE_COMMENTS=true
DRY_RUN=false
