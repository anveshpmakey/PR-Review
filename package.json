{
  "name": "bitbucket-pr-review-agent",
  "version": "2.0.0",
  "description": "LLM-powered (Claude / OpenAI-compatible) pull request reviewer for Bitbucket Cloud",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "pr-review": "src/cli.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "review": "node src/cli.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  }
}
