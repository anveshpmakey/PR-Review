# --- Server ---
PORT=3000
LOG_LEVEL=info

# --- Bitbucket Cloud ---
# Either a repository/workspace access token (recommended) ...
BITBUCKET_ACCESS_TOKEN=
# ... or username + app password (scopes: pullrequest:write, repository:read)
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=
# Default repo for the CLI (the webhook uses repository.full_name from the payload)
BITBUCKET_WORKSPACE=
BITBUCKET_REPO_SLUG=
# Optional comma-separated allow-list of workspace/repo names for the webhook
ALLOWED_REPOS=

# Secret configured on the Bitbucket webhook (verifies X-Hub-Signature HMAC-SHA256)
WEBHOOK_SECRET=

# --- LLM provider: anthropic | openai | mock (auto-detected from API keys when unset) ---
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Any OpenAI-compatible endpoint (Azure OpenAI v1, OpenRouter, LiteLLM, vLLM, Ollama...)
# OPENAI_BASE_URL=https://api.openai.com/v1

LLM_MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_MS=180000
LLM_MAX_RETRIES=3
# LLM_TEMPERATURE=0.2

# --- Review behaviour ---
# general | java-spring
REVIEW_PROFILE=general
# Repo-specific rules file read from the PR's destination branch
REVIEW_GUIDELINES_PATH=.pr-review.md
# Extra inline guidelines applied to every repo
REVIEW_GUIDELINES=
INCLUDE_FILE_CONTEXT=true
MAX_CONTEXT_FILE_CHARS=20000
MAX_DIFF_CHARS=60000
MAX_CHUNKS=10
REVIEW_CONCURRENCY=2
# low | medium | high | critical
MIN_SEVERITY=low
MIN_CONFIDENCE=0.5
MAX_INLINE_COMMENTS=15
# Comma-separated globs
IGNORE_PATHS=
INCLUDE_PATHS=
SKIP_DRAFTS=true
REVIEW_TRIGGER_PHRASE=/ai-review

POST_GENERAL_COMMENT=true
POST_INLINE_COMMENTS=true
DRY_RUN=false
